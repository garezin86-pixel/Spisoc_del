# frontend/.env.example
#
# Скопировать в frontend/.env перед сборкой под конкретного клиента
# (Vite инлайнит значения в бандл на этапе build — не рантайм-конфиг).
# Без этого файла используются дефолты (текущий бренд "Spisoc").

# Название бренда — логотип, заголовок в шапке/логин-экране, <title> вкладки.
# См. frontend/src/constants/branding.js
VITE_APP_NAME=Spisoc

# Базовый URL API, если фронт и API не на одном домене/порту (по умолчанию
# "/api" — относительный путь, подходит для большинства деплоев за одним
# reverse proxy). См. frontend/src/api.js
# VITE_API_BASE=https://api.your-domain.example
