ENV=production

SECRET_KEY=replace-with-strong-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

POSTGRES_DB=spisok_del_db
POSTGRES_USER=spisok_user
POSTGRES_PASSWORD=replace-with-strong-password
DATABASE_URL=postgresql+asyncpg://spisok_user:replace-with-strong-password@postgres:5432/spisok_del_db

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

ADMIN_SECRET_KEY=replace-with-strong-admin-secret
ADMIN_ALLOWED_IPS=

BOT_TOKEN=replace-with-production-bot-token
SUPER_ADMIN_TG_ID=0

GRAFANA_ADMIN_PASSWORD=replace-with-strong-grafana-password
