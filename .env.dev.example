ENV=dev

SECRET_KEY=dev-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

POSTGRES_DB=spisok_del_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/spisok_del_db

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

ADMIN_SECRET_KEY=dev-admin-secret
ADMIN_ALLOWED_IPS=

BOT_TOKEN=put-your-dev-bot-token-here
SUPER_ADMIN_TG_ID=0

GRAFANA_ADMIN_PASSWORD=admin


# --- Company registration ---
# Enable creating a new company (workspace) via POST /auth/register.
# Set true only when testing company registration.
ALLOW_COMPANY_REGISTRATION=false

# --- Telegram chat bridge ---
# Telegram group ID for the chat bridge.
# Leave empty to keep the bridge disabled.
CHAT_BRIDGE_GROUP_ID=

# Workspace ID allowed to use the Telegram chat bridge.
# Required only when CHAT_BRIDGE_GROUP_ID is configured.
# Leave empty until the bridge is configured for a specific workspace.
CHAT_BRIDGE_WORKSPACE_ID=
