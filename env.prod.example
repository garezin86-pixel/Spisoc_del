# ═══════════════════════════════════════════════════════════════════════════
# .env.prod — переменные окружения для ПРОДА.
# Кладётся в корень проекта на сервере. НИКОГДА не коммитить в git
# (уже есть в .gitignore: .env.prod).
#
# Запуск: docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d
#
# Все "REPLACE_ME_..." ниже — обязательны к замене. Если хоть один из трёх
# секретов (SECRET_KEY / ADMIN_SECRET_KEY / REFRESH_SECRET_KEY) останется
# пустым или дефолтным при ENV=production — приложение откажется стартовать
# (см. src/core/config.py, model_validator _require_real_secrets_in_production).
# ═══════════════════════════════════════════════════════════════════════════

ENV=production

# ── JWT ──────────────────────────────────────────────────────────────────
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=REPLACE_ME_run_python_secrets_token_urlsafe_48
REFRESH_SECRET_KEY=REPLACE_ME_run_python_secrets_token_urlsafe_48_DIFFERENT_VALUE
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── База данных ──────────────────────────────────────────────────────────
# Отдельный юзер (не "postgres") — хорошая практика, не обязательно.
# Сгенерировать пароль: python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_DB=spisok_del_db
POSTGRES_USER=spisok_user
POSTGRES_PASSWORD=REPLACE_ME_strong_db_password
DATABASE_URL=postgresql+asyncpg://spisok_user:REPLACE_ME_strong_db_password@postgres:5432/spisok_del_db

# ── Redis ────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ── SQLAdmin ─────────────────────────────────────────────────────────────
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_SECRET_KEY=REPLACE_ME_run_python_secrets_token_urlsafe_48_THIRD_VALUE
# IP через запятую, с которых разрешён доступ к /admin. Пусто = разрешено
# всем (не рекомендуется на публичном сервере) — см. src/admin/views/admin_auth.py
ADMIN_ALLOWED_IPS=

# ── Telegram-бот ─────────────────────────────────────────────────────────
BOT_TOKEN=REPLACE_ME_production_bot_token_from_BotFather
SUPER_ADMIN_TG_ID=0
# ID группы-моста (0/пусто — мост выключен). Получить через /chatid в самой
# группе (см. src/bot/middlewares/auth.py и src/bot/handlers/chat_bridge.py)
CHAT_BRIDGE_GROUP_ID=

# ── Groq (голосовые команды бота — STT + LLM) ───────────────────────────
# Необязательно: без ключа бот работает, просто без распознавания голоса.
GROQ_API_KEY=

# ── Web Push (VAPID) ─────────────────────────────────────────────────────
# Сгенерировать ОДИН РАЗ: python scripts/generate_vapid_keys.py
# Перегенерация аннулирует все существующие подписки браузеров пользователей.
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_CLAIMS_EMAIL=admin@your-domain.example

# ── Мониторинг ───────────────────────────────────────────────────────────
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(16))"
GRAFANA_ADMIN_PASSWORD=REPLACE_ME_strong_grafana_password

# ── CORS / фронтенд ──────────────────────────────────────────────────────
# Реальный домен фронта в проде — без этого браузер срежет запросы с прод-домена
# (см. allow_origins в src/main.py — сейчас там ещё и захардкожен локальный
# dev-IP 192.168.0.147, стоит убрать перед прод-деплоем)
FRONTEND_URL=https://your-domain.example

# ── Sentry (опционально) ─────────────────────────────────────────────────
SENTRY_DSN=

# ── Cloudflare R2 (опционально, для вложений в облаке) ──────────────────
# Пусто = используется локальное файловое хранилище (storage/attachments) —
# на Render free tier и подобных ephemeral-дисках файлы теряются при рестарте.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=spisok-del-attachments
R2_PUBLIC_BASE_URL=
