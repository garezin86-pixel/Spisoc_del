ENV=dev

# JWT
SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database
POSTGRES_DB=spisok_del_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/spisok_del_db

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# SQLAdmin
ADMIN_SECRET_KEY=change-me-admin
ADMIN_ALLOWED_IPS=

# Telegram bot
BOT_TOKEN=put-your-bot-token-here
SUPER_ADMIN_TG_ID=0

# Monitoring
GRAFANA_ADMIN_PASSWORD=admin

# Web Push (VAPID) — сгенерировать один раз: python scripts/generate_vapid_keys.py
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_CLAIMS_EMAIL=you@example.com

# Groq (STT/TTS/LLM)
GROQ_API_KEY=
